<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ 通知运行时权限：同步结束后发系统通知用 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 精确可见性：只声明阅读App的包名与其ContentProvider，
         替代 QUERY_ALL_PACKAGES（避免被国产安全软件标记"获取全部应用列表"） -->
    <queries>
        <package android:name="io.legado.app.release" />
        <package android:name="com.legado.app.release" />
        <package android:name="com.legado.app.releaseA" />
        <provider android:authorities="io.legado.app.release.readerProvider" />
        <provider android:authorities="com.legado.app.release.readerProvider" />
        <provider android:authorities="com.legado.app.releaseA.readerProvider" />
        <!-- 全量可见性：所有带桌面图标的App（覆盖任意包名的阅读发行版），供动态扫描 -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- 阅读App官方在线导入入口 OnLineImportActivity（legado://import/...） -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="legado" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="yuedu" />
        </intent>
    </queries>

    <application
        android:label="同步器"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
